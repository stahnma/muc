[Unit]
Description=My Update Center Client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=muc
Group=muc
ExecStart=/usr/bin/muc-client
# muc-client-recheck.path reloads us after a package transaction; SIGUSR1 makes
# the client re-check for updates immediately instead of waiting out its poll
# interval, so the dashboard reflects a `dnf upgrade` within seconds.
ExecReload=/bin/kill -s USR1 $MAINPID
Restart=always
RestartSec=30
# The client points dnf's cache at $STATE_DIRECTORY (/var/lib/muc). Running
# unprivileged dnf cannot write /var/cache/dnf and otherwise falls back to a
# /var/tmp/dnf-$USER-* directory that PrivateTmp below destroys on every restart
# — which, with Restart=always, means re-downloading tens of megabytes of repo
# metadata each time the service comes back.
StateDirectory=muc
# The client shells out to the system package manager (dnf/apt/yum) to check for
# updates. Those tools must write to /var/cache, /var/lib and /var/log, so
# ProtectSystem=strict (which makes the whole FS read-only) breaks update
# detection. Use 'full' instead: /usr, /boot, /efi and /etc stay read-only while
# the package manager can still refresh its metadata.
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
